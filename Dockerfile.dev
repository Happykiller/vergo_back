# Image de DÉVELOPPEMENT uniquement — la production, elle, se construit avec
# `Dockerfile` (multi-étages, code copié et compilé dans l'image).
#
# Ici rien n'est copié : le code ET node_modules arrivent par bind mount depuis
# l'hôte (voir ../docker-compose.dev.yml). L'image ne sert qu'à figer la version
# de Node sur celle de la production (22).
#
# Prérequis : `npm install` doit avoir été lancé sur l'hôte au préalable.
#
# Pourquoi `slim` (Debian) et non `alpine` comme le Dockerfile de prod : le
# projet a une dépendance native, `sharp`, et le node_modules de l'hôte porte la
# variante glibc (@img/sharp-linux-x64). Alpine étant en musl, elle refuserait
# de se charger. La prod, elle, installe ses propres binaires dans l'image et
# peut donc rester en alpine.
FROM node:22-bookworm-slim

WORKDIR /usr/src/app

EXPOSE 3000

# `start:dev` fixe lui-même NODE_ENV=dev et lance nest en watch.
CMD ["npm", "run", "start:dev"]
