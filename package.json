{
  "name": "vergo_back",
  "version": "1.5.0",
  "description": "Apis for Vergo service",
  "author": "Fabrice Rosito<fabrice.rosito@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "env NODE_ENV=prod nest start",
    "start:watch": "env NODE_ENV=prod nest start --watch",
    "start:dev": "env NODE_ENV=dev nest start --watch",
    "start:mock": "env NODE_ENV=mock nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "env NODE_ENV=test jest --config ./jest.json --coverage --no-cache",
    "test:watch": "env NODE_ENV=test jest --config ./jest.json --watch --coverage --no-cache",
    "test:e2e": "env NODE_ENV=test jest --config ./jest-e2e.json",
    "eros": "eros_gql",
    "link:sunny": "npm link @happykiller/sunny-apis",
    "up:sunny": "npm install @happykiller/sunny-apis@latest --force",
    "seed:stats": "env NODE_ENV=dev ts-node -r tsconfig-paths/register src/cli/seed-stats.ts",
    "reset:password": "env NODE_ENV=dev ts-node -r tsconfig-paths/register src/cli/reset-password.ts"
  },
  "overrides": {
    "@apollo/server-plugin-landing-page-graphql-playground": {
      "@apollo/server": "^5.5.0"
    }
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@happykiller/sunny-apis": "^0.8.2",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@passwordless-id/webauthn": "^2.4.0",
    "body-parser": "^2.3.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mime-types": "^3.0.2",
    "mongodb": "^6.21.0",
    "pluralize": "^8.0.0",
    "sharp": "^0.34.5",
    "stopword": "^3.1.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.2.0",
    "@types/pluralize": "^0.0.33",
    "@types/stopword": "^2.0.3",
    "@types/supertest": "^7.2.1",
    "eros_gql": "^1.2.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "uuid": "^14.0.1"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "^0.34.5"
  }
}
